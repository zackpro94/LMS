# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# Push Notification Settings (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# AI Assistant Configuration (Multi-Provider: Gemini / Groq / DeepSeek / Cohere)
# Get free Gemini API Key at https://aistudio.google.com/
GEMINI_API_KEY=
# Get free Groq API Key at https://console.groq.com/
GROQ_API_KEY=your_free_groq_api_key_here
# Get free OpenRouter/DeepSeek API Key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Get free Cohere API Key at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# Provider selection: 'gemini', 'groq', 'deepseek', 'cohere', or 'auto'
AI_MODEL_PROVIDER=auto


